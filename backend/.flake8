[flake8]
# Match Black's line length so they don't conflict
max-line-length = 88
# E203: whitespace before ':' (Black formats this way)
# E501: line too long (handled by max-line-length above)
extend-ignore = E203, E501

exclude =
    .git,
    __pycache__,
    .venv,
    alembic,
    migrations

per-file-ignores =
    # __init__.py re-exports — unused imports are intentional
    __init__.py: F401
    app/models/__init__.py: F401
    # main.py router includes generate F811 false positives
    app/main.py: F811
