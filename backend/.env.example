# ─────────────────────────────────────────────────────────────────────────────
# GFPMS — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (Local Docker / Cloud Neon) ────────────────────────────────────
POSTGRES_USER=gfpms_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_SERVER=localhost
POSTGRES_DB=gfpms_db

# ── JWT Authentication ────────────────────────────────────────────────────────
SECRET_KEY=generate_a_random_32_byte_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days

# ── Cloudinary (Image/Document Storage) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create a project and go to APIs & Services -> Credentials
# 3. Create an OAuth 2.0 Client ID (Web Application)
# 4. Add Authorized redirect URIs:
#    - http://localhost:8000/api/v1/auth/google/callback
# 5. Add Authorized JavaScript origins:
#    - http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Set to true to restrict Google login exclusively to @skit.ac.in emails
REQUIRE_COLLEGE_DOMAIN=false
ALLOWED_COLLEGE_DOMAIN=skit.ac.in
