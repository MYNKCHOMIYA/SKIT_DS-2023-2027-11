# ─────────────────────────────────────────────────────────────────────────────
# GFPMS — Environment Variables Template
# DevOps / Sprint 1
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in all values marked with <REPLACE_ME>
#   NEVER commit the actual .env file — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (Local Docker) ─────────────────────────────────────────────────
POSTGRES_USER=gfpms_user
POSTGRES_PASSWORD=<REPLACE_ME>
POSTGRES_SERVER=localhost
POSTGRES_DB=gfpms_db

# ── PostgreSQL (Cloud / Neon for production) ──────────────────────────────────
# DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/gfpms_db?sslmode=require

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<REPLACE_ME>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days

# ── Cloudinary (Image/Document Storage) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<REPLACE_ME>
CLOUDINARY_API_KEY=<REPLACE_ME>
CLOUDINARY_API_SECRET=<REPLACE_ME>

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Optional: Vercel Analytics ───────────────────────────────────────────────
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=<REPLACE_ME>
